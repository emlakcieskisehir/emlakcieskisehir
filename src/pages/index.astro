---
import Ana from '../layouts/Ana.astro';
import IlanKart from '../components/IlanKart.astro';
import RehberKart from '../components/RehberKart.astro';
import Ikon from '../components/Ikon.astro';
import ayarlar from '../data/ayarlar.json';
import anasayfa from '../data/anasayfa.json';
import hakkimda from '../data/hakkimda.json';
import yorumData from '../data/yorumlar.json';
import { aktifIlanlar, rehberListesi } from '../lib/icerik';
import { telLink, waLink } from '../lib/yardimci';

const ilanlar = await aktifIlanlar();
const secili = ilanlar.filter((i) => i.data.one_cikan);
const vitrin = (secili.length ? secili : ilanlar).slice(0, 3);
const emlakjetProfil = 'https://www.emlakjet.com/emlak-ofisleri/realty-world-life-gayrimenkul-1814191';
const rehberler = (await rehberListesi()).slice(0, 3);
const yorumlar = (yorumData.yorumlar ?? []).filter((y) => !/örnek|değiştirin|gelecek/i.test(`${y.isim} ${y.metin}`));
const sssSema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: anasayfa.sss.map((s) => ({ '@type': 'Question', name: s.soru, acceptedAnswer: { '@type': 'Answer', text: s.cevap } })),
};
const portre = '/uploads/danisman-ertugrul-seffaf.png';
---
<Ana baslik={`${ayarlar.danisman_adi} – ${ayarlar.sehir} emlak, satılık ve kiralık evler`} schema={sssSema}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-sol">
        <div class="hero-principal">
          <p class="hero-kicker">Eskişehir’de güvenilir emlak danışmanlığı</p>
          <h1 class="merhaba">Evinizi değerinde satıyoruz</h1>
          <p class="hero-alt">Eskişehir’in mahallelerini tanıyan, sürecin her adımında yanınızda olan gayrimenkul danışmanınız Ertuğrul Aydın.</p>
          <div class="hero-butonlar">
            <a class="btn btn--koyu hero-call" href={telLink(ayarlar.telefon)}><span>Hemen arayın</span><small>{ayarlar.telefon}</small></a>
            <a class="btn btn--cizgi" href="/portfoy/">İlanları keşfedin</a>
          </div>
        </div>
        <div class="hero-alt-bilgi">
          <div class="hero-servis-tags">
            <span>Tepebaşı</span><span>Odunpazarı</span><span>Alım · Satım · Kiralama</span>
          </div>
          <a class="asagi" href="#ilanlar">Öne çıkan ilanlar ↓</a>
        </div>
      </div>
      <div class="hero-portre">
        <img src={portre} alt="Ertuğrul Aydın, gayrimenkul danışmanı" width="560" height="700" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="blok blok--zemin proof-section">
    <div class="wrap hakkinda">
      <div class="hakkinda-yazi">
        <span class="hap">Hakkımda</span>
        <h2>{anasayfa.hakkinda_baslik}</h2>
        <p>{hakkimda.kisa_metin}</p>
        <a class="alti-cizili" href="/hakkimda/">Beni tanıyın <span class="ok">↗</span></a>
      </div>
      <div class="kart-istatistik">
        <span class="kart-ikon" aria-hidden="true"><Ikon ad="saat" /></span>
        <div class="buyuk">{ayarlar.sehir}</div>
        <small>Alım, satım ve kiralama için yerel danışmanlık</small>
        <img src="/uploads/eskisehir-porsuk.jpg" alt="Eskişehir merkezinde Porsuk Çayı" loading="lazy" width="800" height="600" />
      </div>
      <ul class="madde-liste">
        <li><span><strong>01</strong> Tepebaşı’nda mahalle odaklı danışmanlık</span></li>
        <li><span><strong>02</strong> Odunpazarı’nda yerel piyasa bilgisi</span></li>
        <li><span><strong>03</strong> Alım, satım ve kiralama desteği</span></li>
      </ul>
    </div>
  </section>

  <section class="blok" id="ilanlar">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Portföy</span><h2>Ofisin güncel ilanları</h2></div>
        <a class="alti-cizili" href={emlakjetProfil} target="_blank" rel="noopener">Ofisin tüm ilanlarını Emlakjet’te görün <span class="ok">↗</span></a>
      </div>
      {vitrin.length > 0 ? <div class="serit">
        {vitrin.map((ilan) => <IlanKart ilan={ilan} />)}
      </div> : <div class="ilan-kaynak-kart"><div><span class="hap">Güncel portföy</span><h3>Ofisin yayındaki ilanlarını görüntüleyin</h3><p>Fiyat ve müsaitlik bilgileri Emlakjet’te güncel tutuluyor.</p></div><a class="btn btn--koyu" href={emlakjetProfil} target="_blank" rel="noopener">Ofis ilanlarını görüntüle <span aria-hidden="true">↗</span></a></div>}
    </div>
  </section>

  <section class="eskisehir-bolum">
    <div class="wrap">
      <div class="blok-ust"><div><span class="hap">Şehrimiz</span><h2>Eskişehir’de yaşamın içinden</h2></div><p>Mahalleleri, ulaşımı ve günlük yaşamı tanıyarak doğru evi bulmanıza yardımcı oluyorum.</p></div>
      <div class="eskisehir-galeri">
        <figure><img src="/uploads/eskisehir-porsuk.jpg" alt="Eskişehir merkezinden Porsuk Çayı manzarası" loading="lazy" /><figcaption><strong>Porsuk kıyısı</strong><span>Şehir merkezinin canlı yaşamı</span></figcaption></figure>
        <figure><img src="/uploads/eskisehir-odunpazari-evleri.jpg" alt="Odunpazarı’nın geleneksel renkli evleri" loading="lazy" /><figcaption><strong>Odunpazarı</strong><span>Tarihi sokaklar ve kendine özgü mahalle dokusu</span></figcaption></figure>
      </div>
      <p class="foto-kredisi">Fotoğraflar: <a href="https://commons.wikimedia.org/wiki/File:Eski%C5%9Fehir_Porsuk_%C3%87ay%C4%B1.jpg" target="_blank" rel="noopener">Raicem</a> ve <a href="https://commons.wikimedia.org/wiki/File:Traditional_Odunpazar%C4%B1_houses,_Eski%C5%9Fehir.jpg" target="_blank" rel="noopener">Serragok</a> / Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>.</p>
    </div>
  </section>

  <section class="blok service-section" style="padding-top:0">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Hizmetler</span><h2>Neler yapıyorum</h2></div>
        <p>İşlem gerçekleşmeden hizmet bedeli almıyorum. Oranı ilk görüşmede yazılı olarak konuşuyoruz.</p>
      </div>
      <div class="service-list">
        {anasayfa.hizmetler.map((h, i) => (
          <details class="service-item" open={i === 0}>
            <summary><span class="service-number">{String(i + 1).padStart(2, '0')}</span><span><strong>{h.baslik}</strong>{h.kimin_icin && <small>{h.kimin_icin}</small>}</span><span class="service-toggle" aria-hidden="true"></span></summary>
            <div class="service-content"><p>{h.metin}</p><div class="rozetler">{(h.etiketler ?? []).map((e: string) => <span class="rozet">{e}</span>)}</div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="wrap">
      <div class="koyu-bant">
        <div class="kucuk">Ücretsiz değerleme</div>
        <h2>Eviniz bugün kaç para eder?</h2>
        <p>Evinizi görüp aynı mahallede son aylarda satılan evlere göre bir fiyat aralığı söylüyorum. Ücret yok, sonrasında benimle çalışmak zorunda değilsiniz.</p>
        <a class="btn btn--acik" href="/satmak-istiyorum/#form">Değerleme iste <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:20px">
    <div class="wrap">
      <div class="blok-ust"><div><span class="hap">Süreç</span><h2>Evinizi satarken neler oluyor</h2></div></div>
      <ol class="surec">
        {anasayfa.surec.map((s) => <li><h3>{s.baslik}</h3><p>{s.metin}</p></li>)}
      </ol>
    </div>
  </section>

  {yorumlar.length > 0 && (
    <section class="blok blok--zemin">
      <div class="wrap">
        <div class="blok-ust">
          <div><span class="hap">Yorumlar</span><h2>Birlikte çalıştıklarım ne diyor</h2></div>
          {ayarlar.google_yorum_linki && <a class="alti-cizili" href={ayarlar.google_yorum_linki} target="_blank" rel="noopener">Google yorumları <span class="ok">↗</span></a>}
        </div>
        <div class="yorumlar">
          {yorumlar.map((y) => (
            <figure class="yorum">
              <blockquote>{y.metin}</blockquote>
              <figcaption><strong>{y.isim}</strong>{'★'.repeat(y.puan || 5)}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="blok">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Bölgeler</span><h2>Çalıştığım mahalleler</h2></div>
        <p>Listede olmayan bir mahalledeyseniz de arayın, {ayarlar.sehir}'in her yerine gidiyorum.</p>
      </div>
      <div class="mahalleler">
        {anasayfa.mahalleler.map((m) => (
          <div>
            <h3><a href={`/portfoy/?ilce=${encodeURIComponent(m.ilce)}`} style="text-decoration:none">{m.ilce}</a></h3>
            <ul class="mahalle-liste">{m.liste.split(',').map((x) => x.trim()).filter(Boolean).map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {rehberler.length > 0 && (
    <section class="blok blok--zemin">
      <div class="wrap">
        <div class="blok-ust ortada" style="display:block">
          <span class="hap">Rehberler</span>
          <h2>Ev alıp satarken bilmeniz gerekenler</h2>
        </div>
        <div class="rehber-grid">
          {rehberler.map((r) => <RehberKart rehber={r} />)}
        </div>
        <p class="ortada" style="margin-top:36px"><a class="alti-cizili" href="/rehberler/">Tüm yazılar <span class="ok">↗</span></a></p>
      </div>
    </section>
  )}

  <section class="blok">
    <div class="wrap">
      <div class="faq-layout">
      <div class="faq-intro"><span class="hap">Yardımcı bilgiler</span><h2>Sık sorulan sorular</h2><img src="/uploads/eskisehir-odunpazari-evleri.jpg" alt="Odunpazarı’ndan geleneksel evler" loading="lazy" /><p>Alım, satım ve kiralama sürecinizle ilgili aklınıza takılanları yanıtlayalım.</p><a class="btn btn--koyu" href="/iletisim/">Bize ulaşın</a></div>
      <div class="sss">
        {anasayfa.sss.map((s) => <details><summary>{s.soru}</summary><p>{s.cevap}</p></details>)}
      </div>
      </div>
    </div>
  </section>

  <section class="blok blok--zemin ortada">
    <div class="wrap">
      <h2 style="max-width:16ch;margin:0 auto 14px">Evinizi satmayı mı düşünüyorsunuz? Konuşalım.</h2>
      <p class="soluk" style="margin-bottom:28px">Telefonla arayabilir, WhatsApp'tan yazabilir ya da ofise uğrayabilirsiniz.</p>
      <div class="butonlar" style="justify-content:center">
        <a class="btn btn--koyu" href={telLink(ayarlar.telefon)}><Ikon ad="telefon" />{ayarlar.telefon}</a>
        <a class="btn btn--cizgi" href={waLink(ayarlar.whatsapp, 'Merhaba Ertuğrul Bey, web sitenizden ulaşıyorum.')} target="_blank" rel="noopener"><Ikon ad="whatsapp" />WhatsApp'tan yaz</a>
      </div>
    </div>
  </section>
</Ana>
