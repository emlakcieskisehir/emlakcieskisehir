---
import Ana from '../layouts/Ana.astro';
import IlanKart from '../components/IlanKart.astro';
import RehberKart from '../components/RehberKart.astro';
import Ikon from '../components/Ikon.astro';
import ayarlar from '../data/ayarlar.json';
import anasayfa from '../data/anasayfa.json';
import hakkimda from '../data/hakkimda.json';
import yorumData from '../data/yorumlar.json';
import { aktifIlanlar, rehberListesi } from '../lib/icerik';
import { telLink, waLink } from '../lib/yardimci';

const ilanlar = await aktifIlanlar();
const secili = ilanlar.filter((i) => i.data.one_cikan);
const vitrin = (secili.length ? secili : ilanlar).slice(0, 8);
const rehberler = (await rehberListesi()).slice(0, 3);
const yorumlar = yorumData.yorumlar ?? [];
const sssSema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: anasayfa.sss.map((s) => ({ '@type': 'Question', name: s.soru, acceptedAnswer: { '@type': 'Answer', text: s.cevap } })),
};
const portre = hakkimda.foto?.includes('danisman.svg') ? '/uploads/portre.svg' : hakkimda.foto;
---
<Ana baslik={`${ayarlar.danisman_adi} – ${ayarlar.sehir} emlak, satılık ve kiralık evler`} schema={sssSema}>
  <section class="hero">
    <div class="wrap">
      <span class="dikey" aria-hidden="true">{ayarlar.unvan}, {ayarlar.sehir}</span>
      <div class="hero-sol">
        <div class="rakamlar">
          {anasayfa.rakamlar.map((r) => <div class="rakam"><strong><sup>+</sup>{r.deger}</strong><span>{r.etiket}</span></div>)}
        </div>
        <div>
          <h1 class="merhaba">{anasayfa.hero_baslik}</h1>
          <p class="hero-alt">{anasayfa.hero_metin}</p>
          <div class="hero-butonlar">
            <a class="btn btn--koyu" href="/satmak-istiyorum/#form">Evimin değerini öğren</a>
            <a class="btn btn--cizgi" href="/portfoy/">İlanlara bak</a>
          </div>
        </div>
        <a class="asagi" href="#ilanlar">Aşağı kaydırın ↓</a>
      </div>
      <div class="hero-portre">
        <img src={portre} alt={ayarlar.danisman_adi} width="560" height="700" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="blok blok--zemin">
    <div class="wrap hakkinda">
      <div class="hakkinda-yazi">
        <span class="hap">Hakkımda</span>
        <h2>{anasayfa.hakkinda_baslik}</h2>
        <p>{hakkimda.kisa_metin}</p>
        <a class="alti-cizili" href="/hakkimda/">Beni tanıyın <span class="ok">↗</span></a>
      </div>
      <div class="kart-istatistik">
        <span class="kart-ikon" aria-hidden="true"><Ikon ad="saat" /></span>
        <div class="buyuk">{anasayfa.istatistik.deger}</div>
        <small>{anasayfa.istatistik.aciklama}</small>
        <img src={hakkimda.foto} alt="" loading="lazy" width="256" height="256" />
      </div>
      <ul class="madde-liste">
        {anasayfa.hizmetler.slice(0, 3).map((h) => <li><span><strong>{h.baslik}</strong>{h.metin}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="blok" id="ilanlar">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Portföy</span><h2>Güncel ilanlar</h2></div>
        <a class="alti-cizili" href="/portfoy/">Tüm ilanlar ({ilanlar.length}) <span class="ok">↗</span></a>
      </div>
      <div class="serit">
        {vitrin.map((ilan) => <IlanKart ilan={ilan} />)}
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Hizmetler</span><h2>Neler yapıyorum</h2></div>
        <p>İşlem gerçekleşmeden hizmet bedeli almıyorum. Oranı ilk görüşmede yazılı olarak konuşuyoruz.</p>
      </div>
      <div class="satirlar">
        {anasayfa.hizmetler.map((h) => (
          <div class="satir">
            <div><h3>{h.baslik}</h3>{h.kimin_icin && <span class="alt">{h.kimin_icin}</span>}</div>
            <p>{h.metin}</p>
            <div class="rozetler">{(h.etiketler ?? []).map((e: string) => <span class="rozet">{e}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:0">
    <div class="wrap">
      <div class="koyu-bant">
        <div class="kucuk">Ücretsiz değerleme</div>
        <h2>Eviniz bugün kaç para eder?</h2>
        <p>Evinizi görüp aynı mahallede son aylarda satılan evlere göre bir fiyat aralığı söylüyorum. Ücret yok, sonrasında benimle çalışmak zorunda değilsiniz.</p>
        <a class="btn btn--acik" href="/satmak-istiyorum/#form">Değerleme iste <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="blok" style="padding-top:20px">
    <div class="wrap">
      <div class="blok-ust"><div><span class="hap">Süreç</span><h2>Evinizi satarken neler oluyor</h2></div></div>
      <ol class="surec">
        {anasayfa.surec.map((s) => <li><h3>{s.baslik}</h3><p>{s.metin}</p></li>)}
      </ol>
    </div>
  </section>

  {yorumlar.length > 0 && (
    <section class="blok blok--zemin">
      <div class="wrap">
        <div class="blok-ust">
          <div><span class="hap">Yorumlar</span><h2>Birlikte çalıştıklarım ne diyor</h2></div>
          {ayarlar.google_yorum_linki && <a class="alti-cizili" href={ayarlar.google_yorum_linki} target="_blank" rel="noopener">Google yorumları <span class="ok">↗</span></a>}
        </div>
        <div class="yorumlar">
          {yorumlar.map((y) => (
            <figure class="yorum">
              <blockquote>{y.metin}</blockquote>
              <figcaption><strong>{y.isim}</strong>{'★'.repeat(y.puan || 5)}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="blok">
    <div class="wrap">
      <div class="blok-ust">
        <div><span class="hap">Bölgeler</span><h2>Çalıştığım mahalleler</h2></div>
        <p>Listede olmayan bir mahalledeyseniz de arayın, {ayarlar.sehir}'in her yerine gidiyorum.</p>
      </div>
      <div class="mahalleler">
        {anasayfa.mahalleler.map((m) => (
          <div>
            <h3><a href={`/portfoy/?ilce=${encodeURIComponent(m.ilce)}`} style="text-decoration:none">{m.ilce}</a></h3>
            <ul class="mahalle-liste">{m.liste.split(',').map((x) => x.trim()).filter(Boolean).map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {rehberler.length > 0 && (
    <section class="blok blok--zemin">
      <div class="wrap">
        <div class="blok-ust ortada" style="display:block">
          <span class="hap">Rehberler</span>
          <h2>Ev alıp satarken bilmeniz gerekenler</h2>
        </div>
        <div class="rehber-grid">
          {rehberler.map((r) => <RehberKart rehber={r} />)}
        </div>
        <p class="ortada" style="margin-top:36px"><a class="alti-cizili" href="/rehberler/">Tüm yazılar <span class="ok">↗</span></a></p>
      </div>
    </section>
  )}

  <section class="blok">
    <div class="wrap">
      <div class="blok-ust ortada" style="display:block"><span class="hap">SSS</span><h2>Sık sorulanlar</h2></div>
      <div class="sss">
        {anasayfa.sss.map((s) => <details><summary>{s.soru}</summary><p>{s.cevap}</p></details>)}
      </div>
    </div>
  </section>

  <section class="blok blok--zemin ortada">
    <div class="wrap">
      <h2 style="max-width:16ch;margin:0 auto 14px">Evinizi satmayı mı düşünüyorsunuz? Konuşalım.</h2>
      <p class="soluk" style="margin-bottom:28px">Telefonla arayabilir, WhatsApp'tan yazabilir ya da ofise uğrayabilirsiniz.</p>
      <div class="butonlar" style="justify-content:center">
        <a class="btn btn--koyu" href={telLink(ayarlar.telefon)}><Ikon ad="telefon" />{ayarlar.telefon}</a>
        <a class="btn btn--cizgi" href={waLink(ayarlar.whatsapp, 'Merhaba Ertuğrul Bey, web sitenizden ulaşıyorum.')} target="_blank" rel="noopener"><Ikon ad="whatsapp" />WhatsApp'tan yaz</a>
      </div>
    </div>
  </section>
</Ana>
