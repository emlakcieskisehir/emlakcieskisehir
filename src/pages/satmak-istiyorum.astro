---
import Ana from '../layouts/Ana.astro';
import DegerlemeForm from '../components/DegerlemeForm.astro';
import ayarlar from '../data/ayarlar.json';
import anasayfa from '../data/anasayfa.json';
import { telLink } from '../lib/yardimci';
---
<Ana baslik={`${ayarlar.sehir}'de evimi satmak istiyorum: ücretsiz değerleme`} aciklama={`${ayarlar.sehir} ${ayarlar.hizmet_bolgeleri} bölgesinde evinizi satmak ya da kiraya vermek için ücretsiz değerleme isteyin. ${ayarlar.danisman_adi}, ${ayarlar.telefon}.`}>
  <section class="sayfa-bas">
    <div class="wrap">
      <div class="yol"><a href="/">Ana sayfa</a> / Evimi satmak istiyorum</div>
      <h1>Gayrimenkulünüzü satmak veya kiraya vermek için profesyonel destek</h1>
      <p>Güncel piyasa verilerine dayalı değerleme ve planlı tanıtım süreciyle gayrimenkulünüz için doğru stratejiyi birlikte oluşturalım.</p>
    </div>
  </section>
  <section class="blok">
    <div class="wrap degerleme">
      <div>
        <h2>Süreç nasıl ilerliyor?</h2>
        <ol class="kontrol-liste" style="padding-left:1.2em">
          {anasayfa.surec.map((s) => <li><strong style="color:var(--siyah)">{s.baslik}.</strong> {s.metin}</li>)}
        </ol>
        <h2 style="margin-top:40px">Danışmanlık yaklaşımım</h2>
        <ul class="kontrol-liste">
          <li>Fiyat önerisini güncel piyasa verileri ve benzer gayrimenkulleri dikkate alarak sunarım.</li>
          <li>Aday görüşmeleri ve teklifler hakkında sizi düzenli olarak bilgilendiririm.</li>
          <li>Hizmet kapsamını ve bedelini iş birliği başlamadan önce açık ve yazılı biçimde netleştiririz.</li>
        </ul>
        <p style="margin-top:28px">Formla uğraşmak istemezseniz: <a href={telLink(ayarlar.telefon)} style="font-weight:700">{ayarlar.telefon}</a></p>
      </div>
      <DegerlemeForm baslik="Değerleme için bilgilerinizi bırakın" />
    </div>
  </section>
</Ana>
