---
import ayarlar from '../data/ayarlar.json';
import Ikon from './Ikon.astro';
import { telLink, waLink } from '../lib/yardimci';
interface Props { baslikSeviye?: 'h1' | 'h2'; }
const { baslikSeviye = 'h2' } = Astro.props;
const Baslik = baslikSeviye;
const harita = `https://maps.google.com/maps?q=${encodeURIComponent('39.7653341,30.5310599')}&z=17&output=embed`;
---
<div class="iletisim">
  <div>
    <div class="iletisim-portre-kart">
      <img src="/uploads/danisman-ertugrul-seffaf.png" alt="Ertuğrul Aydın, gayrimenkul danışmanı" loading="lazy" width="1080" height="1920" />
      <span>Eskişehir’de emlak danışmanlığı</span>
    </div>
    <Baslik>İletişime geçin</Baslik>
    <p class="soluk">Gayrimenkulünüz veya arayışınız hakkında görüşmek için telefon, e-posta ya da WhatsApp üzerinden ulaşabilirsiniz. Ofis ziyareti için önceden randevu almanızı öneririm.</p>
    <dl>
      <div><dt>Telefon</dt><dd><span class="telefon-adi">Ertuğrul Aydın</span><a href={telLink(ayarlar.telefon)}>{ayarlar.telefon}</a></dd></div>
      <div><dt>E-posta</dt><dd><a href={`mailto:${ayarlar.eposta}`}>{ayarlar.eposta}</a></dd></div>
      <div><dt>Ofis adresi</dt><dd><a href={ayarlar.konum_linki} target="_blank" rel="noopener">REALTY WORLD LIFE GAYRİMENKUL, Eskişehir</a></dd></div>
      <div><dt>Hizmet bölgeleri</dt><dd>{ayarlar.hizmet_bolgeleri}, {ayarlar.sehir}</dd></div>
      <div><dt>Çalışma saatleri</dt><dd>{ayarlar.calisma_saatleri}</dd></div>
    </dl>
    <div class="butonlar">
      <a class="btn btn--wa" href={waLink(ayarlar.whatsapp, 'Merhaba Ertuğrul Bey, web sitenizden ulaşıyorum.')} target="_blank" rel="noopener"><Ikon ad="whatsapp" />WhatsApp üzerinden yazın</a>
      <a class="btn btn--cizgi telefon-grup" href={telLink(ayarlar.telefon)}><span class="telefon-adi">Ertuğrul Aydın</span><span><Ikon ad="telefon" />Telefonla arayın</span></a>
      {ayarlar.konum_linki && <a class="btn btn--cizgi" href={ayarlar.konum_linki} target="_blank" rel="noopener">Haritada yol tarifi alın</a>}
    </div>
  </div>
  <div class="harita">
    <iframe src={harita} title="Ertuğrul Aydın Emlak ofis konumu" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</div>
